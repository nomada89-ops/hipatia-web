{
    "name": "horarios-nextgen",
    "private": true,
    "version": "0.0.1",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && electron-builder",
        "build:electron": "tsc -p tsconfig.electron.json",
        "preview": "vite preview",
        "electron:dev": "npm run build:electron && concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5173 && electron . --dev\""
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "framer-motion": "^10.0.0",
        "lucide-react": "^0.260.0",
        "electron-squirrel-startup": "^1.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.15",
        "@types/react-dom": "^18.2.7",
        "@vitejs/plugin-react": "^4.0.3",
        "concurrently": "^8.2.0",
        "cross-env": "^7.0.3",
        "electron": "^25.3.0",
        "electron-builder": "^24.6.3",
        "typescript": "^5.0.2",
        "vite": "^4.4.5",
        "wait-on": "^7.0.1",
        "tailwindcss": "^3.3.3",
        "postcss": "^8.4.27",
        "autoprefixer": "^10.4.14"
    }
}